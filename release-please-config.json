{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/harness-claude-code-bridge": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/harness-claude-code": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/harness-protocol": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/harness-sandbox": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/harness-transport-cloudflare": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/harness-transport": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/redact": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/sandbox-daytona": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/sandbox-e2b": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    },
    "packages/sandbox": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    }
  },
  "group-pull-request-title-pattern": "chore: release ${version}",
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ]
}
