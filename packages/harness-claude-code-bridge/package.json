{
  "name": "@amond-ai/harness-claude-code-bridge",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The per-turn host that runs inside the sandbox image — hosts the Claude Agent SDK's query() and serves the Worker over a WebSocket",
  "scripts": {
    "build": "bun build src/main.ts --target=node --outfile=dist/bridge.mjs --external @anthropic-ai/claude-agent-sdk --external ws --external zod",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@amond-ai/harness-protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "catalog:sandbox-image",
    "ws": "catalog:sandbox-image",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "@types/ws": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
