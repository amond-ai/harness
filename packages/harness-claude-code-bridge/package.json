{
  "name": "@pleaseai/turn-host",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The per-turn host that runs inside the sandbox image — hosts the Claude Agent SDK's query() and serves the Worker over a WebSocket",
  "scripts": {
    "build": "bun build src/main.ts --target=node --outfile=dist/bridge.mjs --external @anthropic-ai/claude-agent-sdk --external ws --external zod",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.215",
    "@pleaseai/harness-protocol": "workspace:*",
    "ws": "8.21.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "^0.0.4",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.4.0",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
