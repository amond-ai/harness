{
  "name": "@amond-ai/harness-sandbox",
  "type": "module",
  "version": "0.1.0",
  "description": "The AI SDK harness's HarnessV1SandboxProvider, written once over @amond-ai/sandbox so every backend behind that contract gets one",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/amond-ai/harness/tree/main/packages/harness-sandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/harness.git",
    "directory": "packages/harness-sandbox"
  },
  "bugs": {
    "url": "https://github.com/amond-ai/harness/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "sandbox",
    "ai-sdk",
    "harness",
    "provider"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@ai-sdk/harness": "catalog:",
    "@amond-ai/sandbox": "workspace:*"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
