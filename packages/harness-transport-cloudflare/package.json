{
  "name": "@pleaseai/harness-cf-transport",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Opens the AI SDK harness bridge socket from workerd — through a Cloudflare Sandbox binding or straight over `fetch` — so the adapter never reaches for `ws`",
  "exports": {
    ".": "./src/index.ts",
    "./ws": "./src/ws.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/sandbox": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:workers-v5",
    "@pleaseai/eslint-config": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
