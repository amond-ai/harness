{
  "name": "@amond-ai/harness-transport-cloudflare",
  "type": "module",
  "version": "0.1.0",
  "description": "Opens the harness bridge socket from workerd — through a sandbox's Durable Object or straight over `fetch` — so the adapter never reaches for `ws`",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/amond-ai/harness/tree/main/packages/harness-transport-cloudflare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/harness.git",
    "directory": "packages/harness-transport-cloudflare"
  },
  "bugs": {
    "url": "https://github.com/amond-ai/harness/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "sandbox",
    "cloudflare",
    "workers",
    "websocket",
    "transport"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./ws": {
      "types": "./dist/ws.d.mts",
      "default": "./dist/ws.mjs"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.mts",
      "default": "./dist/sandbox.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/ws.ts src/sandbox.ts --dts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "@amond-ai/harness-transport": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:workers-v5",
    "@pleaseai/eslint-config": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
