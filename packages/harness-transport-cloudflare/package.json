{
  "name": "@amond-ai/harness-transport-cloudflare",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Opens the harness bridge socket from workerd \u2014 through a Cloudflare Sandbox binding or straight over `fetch` \u2014 so the adapter never reaches for `ws`",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/harness.git",
    "directory": "packages/harness-transport-cloudflare"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ws": "./src/ws.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "@amond-ai/harness-transport": "workspace:*",
    "@cloudflare/sandbox": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:workers-v5",
    "@pleaseai/eslint-config": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
