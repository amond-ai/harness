{
  "name": "@pleaseai/sandbox-e2b",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An e2b backend for @pleaseai/sandbox-contract — journals process transcripts and exit status to the sandbox filesystem, because e2b forgets a process the moment it exits",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@pleaseai/sandbox-contract": "workspace:*",
    "e2b": "catalog:"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
