{
  "name": "@pleaseai/sandbox-e2b",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An e2b backend for @pleaseai/sandbox-contract — journals process transcripts and exit status to the sandbox filesystem, because e2b forgets a process the moment it exits",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@pleaseai/sandbox-contract": "workspace:*",
    "e2b": "^2.45.0"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "^0.0.4",
    "bun-types": "^1.4.0",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
