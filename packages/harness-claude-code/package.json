{
  "name": "@amond-ai/harness-claude-code",
  "type": "module",
  "version": "0.2.0",
  "description": "Starts, watches, attaches to and stops one Claude Code turn in a sandbox — the Worker-side seam both the `claude` CLI exec and the Agent SDK turn host sit behind",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/amond-ai/harness/tree/main/packages/harness-claude-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/harness.git",
    "directory": "packages/harness-claude-code"
  },
  "bugs": {
    "url": "https://github.com/amond-ai/harness/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "sandbox",
    "turn-driver",
    "agent-sdk",
    "ai-sdk"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./outcome": {
      "types": "./dist/outcome.d.mts",
      "default": "./dist/outcome.mjs"
    },
    "./permission-mode": {
      "types": "./dist/permission-mode.d.mts",
      "default": "./dist/permission-mode.mjs"
    },
    "./turn-result": {
      "types": "./dist/turn-result.d.mts",
      "default": "./dist/turn-result.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/outcome.ts src/permission-mode.ts src/turn-result.ts --dts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/harness": "catalog:",
    "@amond-ai/harness-protocol": "workspace:*",
    "@amond-ai/harness-transport": "workspace:*",
    "@amond-ai/redact": "workspace:*",
    "@amond-ai/sandbox": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
