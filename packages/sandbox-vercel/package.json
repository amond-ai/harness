{
  "name": "@amond-ai/sandbox-vercel",
  "type": "module",
  "version": "0.2.0",
  "description": "A Vercel Sandbox backend for @amond-ai/sandbox — journals a process's output to the sandbox filesystem, because Vercel forgets a command across a session resume and exposes no process list",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/amond-ai/harness/tree/main/packages/sandbox-vercel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/harness.git",
    "directory": "packages/sandbox-vercel"
  },
  "bugs": {
    "url": "https://github.com/amond-ai/harness/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "sandbox",
    "vercel",
    "provider"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@amond-ai/sandbox": "workspace:*",
    "@vercel/sandbox": "catalog:"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
