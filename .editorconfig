# EditorConfig — PassionFactory 표준 (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,mjs,cjs}]
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
